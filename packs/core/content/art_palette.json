    { "id": "core:bone", "name": "Bone", "ramp": ["#23202b", "#4b4653", "#8e897c", "#c9c3ae", "#ece6d2"] },
    { "id": "core:iron", "name": "Iron", "ramp": ["#1c1f26", "#3a4150", "#6b7486", "#9aa3b2", "#cdd3dc"] },
    { "id": "core:ember", "name": "Ember", "ramp": ["#2a1410", "#6b2a15", "#b7541f", "#ef8f34", "#ffd28a"] },
    { "id": "core:frost", "name": "Frost", "ramp": ["#101c2a", "#1f3e5c", "#3f7fae", "#83c4e8", "#d6f0ff"] },
    { "id": "core:chitin", "name": "Chitin", "ramp": ["#1b1a10", "#3f3a1c", "#6f6430", "#a3944b", "#d6c77e"] },
    { "id": "core:brass", "name": "Brass", "ramp": ["#241a0f", "#4f3a1c", "#8a6a2c", "#c39a45", "#f0d68a"] },
    { "id": "core:necrotic", "name": "Necrotic", "ramp": ["#0d1a12", "#17351f", "#2f6b3a", "#55a85c", "#a8e6a0"] },
    { "id": "core:ash", "name": "Ash", "ramp": ["#1a1518", "#38302f", "#6a5b53", "#9d8b7d", "#d8c8b6"] },

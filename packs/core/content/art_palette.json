    {
      "_note": "Dungeon ramp. The gap between slot 1 (floor) and slot 3 (wall) is deliberately wide — at 16px with no lighting, silhouette contrast is the only thing that tells a player where they can walk.",
      "id": "core:crypt",
      "name": "Crypt",
      "ramp": ["#07060b", "#171527", "#26233b", "#5b5580", "#8f88bd"]

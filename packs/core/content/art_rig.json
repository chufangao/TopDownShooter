{
  "$schema": "../schemas/art_rig.schema.json",
  "kind": "art_rig",
  "_note": "A rig is a joint tree, a canvas size and default clip bindings (§15.1). ~5 rigs cover the whole roster; a unit's art cost is one rig id. y is negative upward. `z` is the draw order, back to front.",
  "defs": [
    {
      "id": "core:biped",
      "name": "Biped",
      "size": [48, 48],
      "origin": [24, 42],
      "joints": {
        "root": { "parent": null, "at": [0, 0] },
        "hips": { "parent": "root", "at": [0, -12] },
        "torso": { "parent": "hips", "at": [0, -6] },
        "back": { "parent": "torso", "at": [0, -3] },
        "head": { "parent": "torso", "at": [0, -10] },
        "armL": { "parent": "torso", "at": [-5, -6] },
        "armR": { "parent": "torso", "at": [5, -6] },
        "legL": { "parent": "hips", "at": [-3, 0] },
        "legR": { "parent": "hips", "at": [3, 0] }
      },
      "z": ["back", "armL", "legL", "legR", "hips", "torso", "head", "armR"],
      "clips": {
        "idle": "core:clip_idle_breathe",
        "walk": "core:clip_walk_biped",
        "attack": "core:clip_attack_swing",
        "cast": "core:clip_cast_raise",
        "hurt": "core:clip_hurt_recoil",
        "faint": "core:clip_faint_collapse"
      }
    }
  ]
}

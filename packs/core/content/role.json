    { "id": "core:channeler", "name": "Channeler", "thresholds": [2, 3, 4], "autoRow": 2, "heals": true },
    { "id": "core:warden", "name": "Warden", "thresholds": [2, 3, 4], "autoRow": 1, "heals": true },
    { "id": "core:trickster", "name": "Trickster", "thresholds": [2, 3, 4], "autoRow": 1 }
  ]

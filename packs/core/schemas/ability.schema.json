{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinue.local/schemas/ability.schema.json",
  "title": "ability content file",
  "description": "A when gate, a targeting shape, and an ordered list of effects naming registered ops (§11.4). Never code.",
  "type": "object",
  "required": ["kind", "defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "kind": { "const": "ability" },
    "defs": { "type": "array", "items": { "$ref": "#/$defs/ability" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
    "ability": {
      "type": "object",
      "required": ["id", "name", "castCost", "shape", "effects"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "_note": { "type": "string" },
        "name": { "type": "string" },
        "castCost": { "type": "number", "exclusiveMinimum": 0, "description": "Gauge needed to act (§2)." },
        "shape": {
          "enum": ["single", "column", "row", "adjacent", "all", "slot", "self", "ally", "all_allies"],
          "description": "Read directly off the 3×4 grid (§3)."
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11,
          "description": "Required when shape is \"slot\" — snipe a fixed grid index."
        },
        "melee": { "type": "boolean", "description": "Melee reaches only the enemy's frontmost occupied row." },
        "element": { "$ref": "#/$defs/id" },
        "anim": { "$ref": "#/$defs/id" },
        "when": { "type": "array", "description": "expr tree (§11.6); the ability is only offered when it evaluates truthy." },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["op"],
            "properties": {
              "op": { "$ref": "#/$defs/id" },
              "_note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

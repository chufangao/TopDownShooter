{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinue.local/schemas/art_clip.schema.json",
  "title": "art clip content file",
  "description": "Keyframed joint tracks (§15.1). Every track array must have exactly `frames` entries.",
  "type": "object",
  "required": ["kind", "defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "kind": { "const": "art_clip" },
    "defs": { "type": "array", "items": { "$ref": "#/$defs/clip" } }
  },
  "$defs": {
    "clip": {
      "type": "object",
      "required": ["id", "fps", "frames", "tracks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
        "_note": { "type": "string" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "frames": { "type": "integer", "minimum": 1 },
        "loop": { "type": "boolean" },
        "tracks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": { "type": "array", "items": { "type": "number" } },
              "y": { "type": "array", "items": { "type": "number" } },
              "rot": { "type": "array", "items": { "type": "number" }, "description": "Degrees." },
              "scale": { "type": "array", "items": { "type": "number" } }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinue.local/schemas/art_palette.schema.json",
  "title": "art palette content file",
  "type": "object",
  "required": ["kind", "defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "kind": { "const": "art_palette" },
    "defs": { "type": "array", "items": { "$ref": "#/$defs/palette" } }
  },
  "$defs": {
    "palette": {
      "type": "object",
      "required": ["id", "ramp"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
        "_note": { "type": "string" },
        "name": { "type": "string" },
        "ramp": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "description": "Dark → light. Parts index into it as ramp.0 … ramp.N."
        }
      }
    }
  }
}

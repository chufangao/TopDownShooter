{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinue.local/schemas/art_part.schema.json",
  "title": "art part content file",
  "description": "Drawables in joint-local pixels (§15.1). `fill` is always a palette slot, never a raw colour — that is what makes a recolour mod a patch file with no PNGs.",
  "type": "object",
  "required": ["kind", "defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "kind": { "const": "art_part" },
    "defs": { "type": "array", "items": { "$ref": "#/$defs/part" } }
  },
  "$defs": {
    "fill": { "type": "string", "pattern": "^(ramp|accent)\\.[0-9]+$" },
    "part": {
      "type": "object",
      "required": ["id", "shapes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
        "_note": { "type": "string" },
        "shapes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["ellipse", "rect", "capsule", "poly"] },
              "fill": { "$ref": "#/$defs/fill" },
              "cx": { "type": "number" },
              "cy": { "type": "number" },
              "rx": { "type": "number" },
              "ry": { "type": "number" },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number" },
              "h": { "type": "number" },
              "x1": { "type": "number" },
              "y1": { "type": "number" },
              "x2": { "type": "number" },
              "y2": { "type": "number" },
              "r": { "type": "number" },
              "points": {
                "type": "array",
                "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
              },
              "_note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

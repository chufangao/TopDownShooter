{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinue.local/schemas/art_rig.schema.json",
  "title": "art rig content file",
  "description": "Joint tree + canvas size + default clip bindings (§15.1). ~5 rigs cover the roster.",
  "type": "object",
  "required": ["kind", "defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "kind": { "const": "art_rig" },
    "defs": { "type": "array", "items": { "$ref": "#/$defs/rig" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
    "xy": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "rig": {
      "type": "object",
      "required": ["id", "size", "origin", "joints", "z", "clips"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "_note": { "type": "string" },
        "name": { "type": "string" },
        "size": { "$ref": "#/$defs/xy" },
        "origin": { "$ref": "#/$defs/xy", "description": "Pixel position of the root joint. y is negative upward." },
        "joints": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["parent", "at"],
            "additionalProperties": false,
            "properties": {
              "parent": { "type": ["string", "null"] },
              "at": { "$ref": "#/$defs/xy" },
              "_note": { "type": "string" }
            }
          }
        },
        "z": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Draw order, back to front. A joint absent from z never draws."
        },
        "clips": {
          "type": "object",
          "required": ["idle", "walk", "attack", "cast", "hurt", "faint"],
          "additionalProperties": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}

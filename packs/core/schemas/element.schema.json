{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinue.local/schemas/element.schema.json",
  "title": "element content file",
  "type": "object",
  "required": ["kind", "defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "kind": { "const": "element" },
    "defs": { "type": "array", "items": { "$ref": "#/$defs/element" } }
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
        "_note": { "type": "string" },
        "name": { "type": "string" },
        "tint": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Renderer-only. The sim never reads it." },
        "affinity": {
          "type": "object",
          "description": "Defender element id → multiplier. Unlisted matchups are 1.0 (§2).",
          "propertyNames": { "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}

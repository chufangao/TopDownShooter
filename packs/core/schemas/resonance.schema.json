{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinue.local/schemas/resonance.schema.json",
  "title": "resonance content file",
  "description": "Layer 1 of §3 synergy: automatic, threshold-driven, always on. {when, modifiers[], hooks[]} — the same shape an item, keystone, shrine curse and Lattice node use.",
  "type": "object",
  "required": ["kind", "defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "kind": { "const": "resonance" },
    "defs": { "type": "array", "items": { "$ref": "#/$defs/synergy" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
    "modifier": {
      "type": "object",
      "required": ["path", "op", "v"],
      "additionalProperties": false,
      "description": "The one stat pipeline (§11.3). Applied set → add → mul → clamp, order-independent.",
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
        "op": { "enum": ["set", "add", "mul", "clamp"] },
        "v": {},
        "prio": { "type": "number" },
        "_note": { "type": "string" }
      }
    },
    "hookRow": {
      "type": "object",
      "required": ["point", "field", "op"],
      "additionalProperties": false,
      "description": "One nudge to one field of one hook proposal (§11.5).",
      "properties": {
        "point": { "type": "string" },
        "field": { "type": "string" },
        "op": { "enum": ["set", "add", "mul"] },
        "v": {},
        "prio": { "type": "number" },
        "when": { "type": "array", "description": "expr tree (§11.6)" },
        "_note": { "type": "string" },
        "on": {
          "enum": ["actor", "target"],
          "description": "Which participant must be the bearer for this row to fire. Defaults to target."
        }
      }
    },
    "synergy": {
      "type": "object",
      "required": ["id", "name", "when"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "_note": { "type": "string" },
        "name": { "type": "string" },
        "desc": { "type": "string", "description": "Codex text, shown to the player." },
        "recipe": { "type": "string", "description": "Human-readable threshold summary, e.g. \"Drake 2 + Vanguard 2\"." },
        "when": { "type": "array", "description": "expr tree (§11.6); true means the synergy is active." },
        "modifiers": { "type": "array", "items": { "$ref": "#/$defs/modifier" } },
        "hooks": { "type": "array", "items": { "$ref": "#/$defs/hookRow" } }
      }
    }
  }
}

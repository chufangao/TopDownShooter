{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinue.local/schemas/role.schema.json",
  "title": "role content file",
  "type": "object",
  "required": ["kind", "defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "kind": { "const": "role" },
    "defs": { "type": "array", "items": { "$ref": "#/$defs/role" } }
  },
  "$defs": {
    "role": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
        "_note": { "type": "string" },
        "name": { "type": "string" },
        "thresholds": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "heals": {
          "type": "boolean",
          "description": "Whether this Role sustains the party. The Targeting doctrine's 'healers first' mode reads this rather than naming Roles in code (§12)."
        },
        "autoRow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "Default row for the Formation doctrine's auto-fill rule (§4)."
        }
      }
    }
  }
}

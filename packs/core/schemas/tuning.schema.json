{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinue.local/schemas/tuning.schema.json",
  "title": "tuning content file",
  "description": "Every constant from §2 and §5 in one file (§16.1) — the whole balance surface, patchable by mods and sweepable by tools/balance.js without editing code.",
  "type": "object",
  "required": ["kind", "defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "kind": { "const": "tuning" },
    "defs": { "type": "array", "items": { "$ref": "#/$defs/tuning" } }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "meleeReach": { "type": "boolean" },
        "aggro": { "type": "number", "minimum": 0 },
        "meleeDealt": { "type": "number", "minimum": 0 },
        "meleeTaken": { "type": "number", "minimum": 0 },
        "_note": { "type": "string" }
      }
    },
    "tuning": {
      "type": "object",
      "required": ["id", "tick", "hit", "crit", "damage", "variance", "rows", "persuade", "xp"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
        "_note": { "type": "string" },
        "tick": {
          "type": "object",
          "required": ["hz", "ms"],
          "properties": {
            "hz": { "type": "number", "exclusiveMinimum": 0 },
            "ms": { "type": "number", "exclusiveMinimum": 0 },
            "ceiling": { "type": "integer", "minimum": 1 },
            "_note": { "type": "string" }
          }
        },
        "hit": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "_note": { "type": "string" }
          }
        },
        "crit": {
          "type": "object",
          "required": ["min", "max", "mult", "divisor"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "mult": { "type": "number" },
            "divisor": { "type": "number", "exclusiveMinimum": 0 },
            "_note": { "type": "string" }
          }
        },
        "damage": {
          "type": "object",
          "required": ["atkDivisor", "defConstant", "min"],
          "properties": {
            "atkDivisor": { "type": "number", "exclusiveMinimum": 0 },
            "defConstant": { "type": "number", "exclusiveMinimum": 0 },
            "min": { "type": "number" },
            "_note": { "type": "string" }
          }
        },
        "variance": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "gauge": { "type": "object" },
        "formation": { "type": "object" },
        "rows": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/row" }
        },
        "persuade": {
          "type": "object",
          "required": ["threshold", "decay", "max", "charmDivisor", "weakenBonus", "base"],
          "properties": {
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "decay": { "type": "number", "minimum": 0, "maximum": 1 },
            "max": { "type": "number", "minimum": 0, "maximum": 1 },
            "charmDivisor": { "type": "number", "exclusiveMinimum": 0 },
            "weakenBonus": { "type": "number" },
            "kinAffinity": { "type": "number" },
            "base": { "type": "object", "additionalProperties": { "type": "number" } },
            "_note": { "type": "string" }
          }
        },
        "party": { "type": "object" },
        "residue": { "type": "object" },
        "insight": { "type": "object" },
        "lattice": { "type": "object" },
        "offline": { "type": "object" },
        "escalation": { "type": "object" },
        "run": { "type": "object" },
        "xp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perTier", "perLevel", "recruitShare", "fallenShare", "base", "exponent", "cap", "capPerStar"],
          "properties": {
            "perTier": { "type": "number", "minimum": 0 },
            "perLevel": { "type": "number", "minimum": 0 },
            "recruitShare": { "type": "number", "minimum": 0 },
            "fallenShare": { "type": "number", "minimum": 0 },
            "base": { "type": "number", "minimum": 1 },
            "exponent": { "type": "number", "minimum": 0 },
            "cap": { "type": "integer", "minimum": 1 },
            "capPerStar": { "type": "integer", "minimum": 0 },
            "_note": { "type": "string" }
          }
        }
      }
    }
  }
}

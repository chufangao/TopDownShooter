{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retinue.local/schemas/unit.schema.json",
  "title": "unit content file",
  "type": "object",
  "required": ["kind", "defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_note": { "type": "string" },
    "kind": { "const": "unit" },
    "defs": { "type": "array", "items": { "$ref": "#/$defs/unit" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
    "stats": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "properties": {
        "hp": { "type": "number" },
        "atk": { "type": "number" },
        "def": { "type": "number" },
        "spd": { "type": "number" },
        "acc": { "type": "number" },
        "eva": { "type": "number" },
        "crt": { "type": "number" }
      }
    },
    "unit": {
      "type": "object",
      "required": ["id", "name", "kin", "role", "tier", "base", "abilities", "art"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "_note": { "type": "string" },
        "name": { "type": "string" },
        "kin": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "element": { "$ref": "#/$defs/id" },
        "tier": { "type": "integer", "minimum": 1, "maximum": 5 },
        "base": { "allOf": [{ "$ref": "#/$defs/stats" }], "required": ["hp", "atk", "def", "spd", "acc", "eva", "crt"] },
        "growth": { "$ref": "#/$defs/stats", "description": "Per level above 1." },
        "abilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "art": {
          "type": "object",
          "required": ["descriptor"],
          "additionalProperties": false,
          "description": "descriptor, not sheet: sprites are generated from a JSON descriptor and baked ahead of time (§15).",
          "properties": {
            "descriptor": { "$ref": "#/$defs/id" },
            "attackTemplate": { "$ref": "#/$defs/id" },
            "_note": { "type": "string" }
          }
        },
        "spawn": {
          "type": "object",
          "additionalProperties": false,
          "description": "How this unit appears in the wild (§6.2). Read by any spawn table declaring units:\"*\", which is what keeps adding a unit down to one JSON file and one descriptor.",
          "properties": {
            "weight": { "type": "number", "minimum": 0 },
            "floors": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "integer", "minimum": 1 },
              "description": "[first, last] floor, inclusive. Omitted means every floor."
            },
            "when": { "type": "array", "description": "expr tree (§11.6)" },
            "_note": { "type": "string" }
          }
        },
        "boss": {
          "type": "boolean",
          "description": "A boss is a unit def with a flag, not a new kind (§6.3): one slot, no formation, persuade-immune by default, and escalation deferred."
        },
        "persuadable": {
          "type": "boolean",
          "description": "Defaults to true for an ordinary unit and false for a boss. A recruitable boss should be a designed exception, never an accident of the tier table."
        },
        "phases": {
          "type": "array",
          "description": "HP-fraction thresholds that apply a status (§6.3). A status is already {modifiers, hooks, dur}, so a phase change is a data row and boss mechanics cost no new code. Ordered by descending `at`.",
          "items": {
            "type": "object",
            "required": ["at", "grant"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "grant": { "$ref": "#/$defs/id" },
              "_note": { "type": "string" }
            }
          }
        },
        "branches": {
          "type": "array",
          "description": "Level 5 and 10 choices (§3). Each is 1 of 2, data-driven.",
          "items": {
            "type": "object",
            "required": ["at", "opts"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "integer", "minimum": 2 },
              "opts": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" } },
              "_note": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
